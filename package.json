{
  "name": "dsh-plugin-readlater",
  "version": "0.1.0",
  "description": "Read-later for DSH: paste a share link, parse it locally into a cached article card, and project it to Obsidian on demand. 稍后阅读：本地解析、缓存图文，按需投影到 Obsidian。",
  "license": "MIT",
  "author": "Yee",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "readlater",
    "clipper",
    "obsidian"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "lib/blocks.js",
    "lib/browser.js",
    "lib/client.js",
    "lib/index.js",
    "lib/ingest.js",
    "lib/media.js",
    "lib/md.js",
    "lib/normalize.js",
    "lib/project.js",
    "lib/render.js",
    "lib/sanitize.js",
    "lib/settings.js",
    "lib/store.js",
    "lib/throttle.js",
    "lib/wechat.js",
    "lib/xhs.js",
    "scripts/import-inread.mjs",
    "scripts/rerender.mjs",
    "test/md.mjs"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1578361862-art/dsh-plugin-readlater.git"
  },
  "homepage": "https://github.com/1578361862-art/dsh-plugin-readlater#readme",
  "bugs": {
    "url": "https://github.com/1578361862-art/dsh-plugin-readlater/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dependencies": {
    "linkedom": "^0.18.15",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
