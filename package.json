{
  "name": "dsh-plugin-readlater",
  "version": "0.1.0",
  "description": "稍后阅读：粘贴分享链接，本地解析成图文/视频卡片，图片视频一并缓存，按需投影到 Obsidian。",
  "license": "MIT",
  "author": "Yee",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "readlater",
    "clipper",
    "obsidian"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/normalize.js",
    "lib/media.js",
    "lib/browser.js",
    "lib/sanitize.js",
    "lib/xhs.js",
    "lib/wechat.js",
    "lib/project.js",
    "lib/render.js",
    "lib/store.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dependencies": {
    "linkedom": "^0.18.15",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
